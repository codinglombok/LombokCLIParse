{
    "name": "codinglombok/lombokcliparse",
    "description": "Command-line parser with flags, typed options, subcommands, environment fallback and generated help; identical behaviour and help text in PHP, Rust, TypeScript, Python and Go. Zero dependencies.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "cli",
        "argument",
        "parser",
        "command-line",
        "flags",
        "options",
        "subcommands"
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "LombokCLIParse\\": "src/"
        }
    },
    "homepage": "https://github.com/codinglombok/LombokCLIParse",
    "authors": [
        {
            "name": "codinglombok"
        }
    ],
    "scripts": {
        "test": "php tests/run.php"
    }
}
